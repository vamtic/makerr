import { ScrollView, ComboBox, LineEdit, SpinBox, Palette, AboutSlint } from "std-widgets.slint";

export struct LogItem {
    level: int,
    message: string,
}

// ----------------------------------------------------------------------------
// Design tokens ("Refined Dark Studio")
// ----------------------------------------------------------------------------
export global Theme {
    in-out property <color> bg: #070b12;
    in-out property <color> card: #0f1726f2;
    in-out property <color> card-hover: #142033f5;
    in-out property <color> input: #0a1120;
    in-out property <color> track: #1a2a3f;
    in-out property <color> border: #223047cc;
    in-out property <color> border-strong: #2d405c;
    in-out property <color> text: #f8fafc;
    in-out property <color> text2: #cbd5e1;
    in-out property <color> text3: #9aa9bd;
    in-out property <color> accent: #00e6a0;
    in-out property <color> hover: #00b37e;
    in-out property <color> success: #34d399;
    in-out property <color> warn: #fbbf24;
    in-out property <color> danger: #f87171;
    in-out property <color> violet: #a78bfa;
    in-out property <length> radius: 8px;
    in-out property <length> radius-lg: 12px;

    // Derived from `accent` so every themed surface follows the Appearance
    // setting instead of hard-coded blues.
    out property <color> on-accent: #03110c;
    out property <color> accent-text: accent.mix(#ffffff, 0.72);
    out property <color> accent-border: accent.mix(#ffffff, 0.85);
    out property <color> warn-soft: warn.mix(#000000, 0.82);
    out property <color> accent-soft-border: accent.mix(#0b1220, 0.6);
    out property <color> accent-soft: accent.mix(#0b1220, 0.25);
    out property <color> accent-faint: accent.mix(#0b1220, 0.12);
    out property <color> accent-pressed: accent.mix(#000000, 0.75);
}

// ----------------------------------------------------------------------------
// Icon assets (SVG, tinted at the use site via `colorize`)
// ----------------------------------------------------------------------------
export global Icons {
    out property <image> play: @image-url("icons/play.svg");
    out property <image> film: @image-url("icons/film.svg");
    out property <image> download: @image-url("icons/download.svg");
    out property <image> upload: @image-url("icons/upload.svg");
    out property <image> settings: @image-url("icons/settings.svg");
    out property <image> folder: @image-url("icons/folder.svg");
    out property <image> close: @image-url("icons/close.svg");
    out property <image> chevron-down: @image-url("icons/chevron-down.svg");
    out property <image> chevron-right: @image-url("icons/chevron-right.svg");
    out property <image> chevron-left: @image-url("icons/chevron-left.svg");
    out property <image> check: @image-url("icons/check.svg");
    out property <image> plus: @image-url("icons/plus.svg");
    out property <image> minus: @image-url("icons/minus.svg");
    out property <image> terminal: @image-url("icons/terminal.svg");
    out property <image> trash: @image-url("icons/trash.svg");
    out property <image> copy: @image-url("icons/copy.svg");
    out property <image> alert: @image-url("icons/alert.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> calendar: @image-url("icons/calendar.svg");
    out property <image> map-pin: @image-url("icons/map-pin.svg");
    out property <image> image: @image-url("icons/image.svg");
    out property <image> sliders: @image-url("icons/sliders.svg");
    out property <image> palette: @image-url("icons/palette.svg");
    out property <image> server: @image-url("icons/server.svg");
    out property <image> globe: @image-url("icons/globe.svg");
    out property <image> eye: @image-url("icons/eye.svg");
    out property <image> fullscreen: @image-url("icons/fullscreen.svg");
    out property <image> help: @image-url("icons/help.svg");
}

// ----------------------------------------------------------------------------
// Reusable primitives
// ----------------------------------------------------------------------------

component Icon inherits Image {
    in property <length> icon-size: 16px;
    in property <color> tint: Theme.text2;
    source: Icons.info;
    width: root.icon-size;
    height: root.icon-size;
    colorize: root.tint;
    image-fit: contain;
}

// Three-tier button: primary (accent), secondary (subtle fill), danger.
component ActionButton inherits Rectangle {
    in property <string> label: "";
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> interactive: true;
    // Set while a modal dialog is open so Tab navigation cannot escape into
    // the dimmed background UI.
    in property <bool> inert: false;
    in property <length> control-height: 34px;
    callback activated();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.interactive) { root.activated(); } }

    height: Math.max(root.control-height, 1.2rem + 20px);
    opacity: root.interactive ? 1.0 : 0.62;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: !root.interactive ? Theme.border
        : root.primary ? Theme.accent-border
        : root.danger ? #ef444499
        : Theme.border-strong;
    background: !root.interactive ? Theme.input
        : root.primary ? (ta.pressed ? Theme.accent-pressed : (ta.has-hover
            ? @linear-gradient(135deg, Theme.accent.mix(#000000, 0.85) 0%, Theme.accent.mix(#000000, 0.55) 100%)
            : @linear-gradient(135deg, Theme.accent 0%, Theme.accent.mix(#000000, 0.75) 62%, Theme.accent.mix(#000000, 0.5) 100%)))
        : root.danger ? (ta.pressed ? #7f1d1d : (ta.has-hover ? #4c1d24 : #341521))
        : (ta.pressed ? #0b1424 : (ta.has-hover ? Theme.card-hover : Theme.input));

    ta := TouchArea {
        enabled: root.interactive;
        clicked => { fs.focus(); root.activated(); }
    }

    fs := FocusScope {
        focus-on-click: false;
        enabled: root.interactive;
        focus-on-tab-navigation: !root.inert;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        alignment: center;
        spacing: 7px;
        if root.show-icon : Icon {
            source: root.icon;
            icon-size: 15px;
            y: (parent.height - self.height) / 2;
            tint: !root.interactive ? Theme.text3 : root.primary ? Theme.on-accent : root.danger ? #fecdd3 : Theme.text2;
        }
        if root.label != "" : Text {
            text: root.label;
            color: !root.interactive ? Theme.text3 : root.primary ? Theme.on-accent : root.danger ? #fecdd3 : Theme.text;
            font-size: 0.9375rem;
            font-weight: root.primary ? 700 : 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if fs.has-focus && root.interactive : Rectangle {
        border-width: 1px;
        border-radius: Theme.radius;
        border-color: Theme.accent;
    }
}

// Small square icon button used for zoom, steppers and toolbar actions.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label: "";
    in property <bool> interactive: true;
    in property <bool> inert: false;
    in property <bool> selected: false;
    in property <length> button-size: 28px;
    callback activated();

    accessible-role: button;
    accessible-label: root.label;

    width: Math.max(root.button-size, 1.4rem);
    height: Math.max(root.button-size, 1.4rem);
    border-radius: 6px;
    border-width: root.selected ? 1px : 0px;
    border-color: root.selected ? Theme.accent-soft-border : transparent;
    background: !root.interactive ? transparent
        : root.selected ? Theme.accent-soft
        : (ta.has-hover ? Theme.card-hover : transparent);

    ta := TouchArea {
        enabled: root.interactive;
        clicked => { fs.focus(); root.activated(); }
    }

    fs := FocusScope {
        focus-on-click: false;
        enabled: root.interactive;
        focus-on-tab-navigation: !root.inert;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    Icon {
        source: root.icon;
        icon-size: 15px;
        tint: !root.interactive ? Theme.text3
            : (ta.has-hover || root.selected ? Theme.accent : Theme.text3);
    }

    if root.label != "" : Tooltip {
        Text { text: root.label; }
    }

    if fs.has-focus && root.interactive : Rectangle {
        border-width: 1px;
        border-radius: 6px;
        border-color: Theme.accent;
    }
}

// Compact pill button (date presets, console filters).
component Chip inherits Rectangle {
    in property <string> label: "";
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <bool> active: false;
    in property <bool> interactive: true;
    in property <bool> inert: false;
    callback activated();

    accessible-role: button;
    accessible-label: root.label;

    height: Math.max(26px, 1.1rem + 12px);
    border-radius: 13px;
    border-width: 1px;
    border-color: !root.interactive ? Theme.border
        : root.active ? Theme.accent-soft-border
        : (ta.has-hover ? Theme.border-strong : Theme.border);
    background: !root.interactive ? Theme.input
        : root.active ? Theme.accent-soft
        : (ta.has-hover ? Theme.card-hover : Theme.input);

    ta := TouchArea {
        enabled: root.interactive;
        clicked => { fs.focus(); root.activated(); }
    }

    fs := FocusScope {
        focus-on-click: false;
        enabled: root.interactive;
        focus-on-tab-navigation: !root.inert;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        spacing: 5px;
        if root.show-icon : Icon {
            source: root.icon;
            icon-size: 12px;
            y: (parent.height - self.height) / 2;
            tint: root.active ? Theme.accent : Theme.text3;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.accent-text : Theme.text2;
            font-size: 0.875rem;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }

    if fs.has-focus && root.interactive : Rectangle {
        border-width: 1px;
        border-radius: 13px;
        border-color: Theme.accent;
    }
}

// Settings navigation entry (vertical tab).
component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <image> icon;
    in property <bool> active: false;
    callback activated();

    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.active;

    height: 40px;
    border-radius: 8px;
    background: root.active ? Theme.accent-soft
        : (ta.has-hover ? Theme.card-hover : transparent);

    ta := TouchArea {
        clicked => { fs.focus(); root.activated(); }
    }

    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 10px;
        spacing: 9px;
        alignment: center;
        Rectangle {
            width: 3px;
            height: 17px;
            border-radius: 2px;
            background: root.active ? Theme.accent : transparent;
            y: (parent.height - self.height) / 2;
        }
        Icon {
            source: root.icon;
            icon-size: 16px;
            tint: root.active ? Theme.accent : Theme.text3;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.text2;
            font-size: 0.9375rem;
            font-weight: root.active ? 700 : 500;
            vertical-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if fs.has-focus : Rectangle {
        border-width: 1px;
        border-radius: 8px;
        border-color: Theme.accent;
    }
}

// Card surface with a left accent pill and optional metadata.
component Card inherits Rectangle {
    in property <string> title: "";
    in property <string> meta: "";
    in property <int> step: 0;
    in property <color> accent: Theme.accent;

    border-radius: Theme.radius-lg;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 11px;
        spacing: 8px;

        if root.title != "" : Rectangle {
            background: transparent;
            HorizontalLayout {
                spacing: 8px;
                if root.step > 0 : Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: Theme.accent-soft;
                    border-width: 1px;
                    border-color: Theme.accent-soft-border;
                    y: (parent.height - self.height) / 2;
                    Text {
                        text: root.step == 1 ? "1" : root.step == 2 ? "2" : root.step == 3 ? "3" : "4";
                        color: Theme.accent;
                        font-size: 0.8125rem;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.step == 0 : Rectangle {
                    width: 3px;
                    height: 14px;
                    border-radius: 2px;
                    background: root.accent;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 1.0625rem;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if root.meta == "" : Rectangle { horizontal-stretch: 1; }
                if root.meta != "" : Text {
                    text: root.meta;
                    color: Theme.text3;
                    font-size: 0.875rem;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        VerticalLayout {
            spacing: 8px;
            @children
        }
    }
}

// Labelled text input with inline validation styling.
component FormField inherits VerticalLayout {
    in property <string> label: "";
    in property <string> placeholder: "";
    in property <string> error: "";
    in-out property <string> value: "";
    in property <bool> interactive: true;
    callback edited(string);

    spacing: 5px;

    if root.label != "" : Text {
        text: root.label;
        color: Theme.text2;
        font-size: 0.9375rem;
        font-weight: 500;
        overflow: elide;
    }

    Rectangle {
        height: Math.max(34px, 1.2rem + 20px);
        border-radius: 6px;
        border-width: (root.error != "" || field.has-focus) ? 1px : 0px;
        border-color: root.error != "" ? Theme.danger : Theme.accent;
        background: transparent;

        field := LineEdit {
            text <=> root.value;
            placeholder-text: root.placeholder;
            enabled: root.interactive;
            edited(t) => { root.edited(t); }
        }

        if root.error != "" || field.has-focus : Rectangle {
            width: 100%;
            height: 100%;
            border-width: 1px;
            border-radius: 6px;
            border-color: root.error != "" ? Theme.danger : Theme.accent;
            background: transparent;
        }
    }

    if root.error != "" : Text {
        text: root.error;
        color: Theme.danger;
        font-size: 0.875rem;
        wrap: word-wrap;
    }
}

// Text input paired with a browse action (folders, audio files).
component FileField inherits VerticalLayout {
    in property <string> label: "";
    in property <string> placeholder: "";
    in property <string> error: "";
    in property <string> button-label: "Browse";
    in property <string> clear-label: "Clear";
    in property <bool> interactive: true;
    in-out property <string> value: "";
    callback edited(string);
    callback browse();

    spacing: 5px;

    if root.label != "" : Text {
        text: root.label;
        color: Theme.text2;
        font-size: 0.9375rem;
        font-weight: 500;
        overflow: elide;
    }

    HorizontalLayout {
        spacing: 6px;

        Rectangle {
            horizontal-stretch: 1;
            height: Math.max(40px, 1.2rem + 24px);
            border-radius: 6px;
            border-width: (root.error != "" || field.has-focus) ? 1px : 0px;
            border-color: root.error != "" ? Theme.danger : Theme.accent;
            background: Theme.input;

            field := LineEdit {
                text <=> root.value;
                placeholder-text: root.placeholder;
                enabled: root.interactive;
                // Show the tail of the path (the meaningful part) unless the
                // user is editing, where the caret should be visible.
                horizontal-alignment: field.has-focus ? left : right;
                edited(t) => { root.edited(t); }
            }

            Tooltip {
                Text {
                    text: root.value;
                    max-width: 460px;
                    wrap: word-wrap;
                }
            }

            if root.error != "" || field.has-focus : Rectangle {
                width: 100%;
                height: 100%;
                border-width: 1px;
                border-radius: 6px;
                border-color: root.error != "" ? Theme.danger : Theme.accent;
                background: transparent;
            }
        }

        if root.value != "" : IconButton {
            icon: Icons.close;
            label: root.clear-label;
            button-size: 38px;
            inert: !root.interactive;
            y: (parent.height - self.height) / 2;
            activated => {
                root.value = "";
                root.edited("");
            }
        }

        ActionButton {
            width: 110px;
            control-height: 40px;
            inert: !root.interactive;
            y: (parent.height - self.height) / 2;
            show-icon: true;
            icon: Icons.folder;
            label: root.button-label;
            activated => { root.browse(); }
        }
    }

    if root.error != "" : Text {
        text: root.error;
        color: Theme.danger;
        font-size: 0.875rem;
        wrap: word-wrap;
    }
}

// Track-style slider with a visible fill and a high-contrast knob.
component SliderBar inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value: 0;
    in property <bool> interactive: true;
    in property <bool> inert: false;
    callback changed(float);
    callback released(float);

    accessible-role: slider;
    accessible-value: Math.round(root.value);
    // Keyboard and assistive-tech stepping. Consumers of `changed` own the
    // actual value, so never assign `root.value` here.
    accessible-action-increment => { root.step-by(root.step); }
    accessible-action-decrement => { root.step-by(-root.step); }

    public function step-by(delta: float) {
        if (!root.interactive) { return; }
        let next = Math.min(root.maximum, Math.max(root.minimum, root.value + delta));
        if (next == root.value) { return; }
        root.changed(next);
        root.released(next);
    }

    height: 20px;
    background: transparent;

    property <float> frac: Math.min(1.0, Math.max(0.0,
        (root.value - root.minimum) / Math.max(0.001, root.maximum - root.minimum)));

    track := Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * root.frac;
            height: parent.height;
            border-radius: 2px;
            background: root.interactive ? Theme.accent : Theme.text3;
        }
    }

    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        x: (parent.width - self.width) * root.frac;
        y: (parent.height - self.height) / 2;
        background: #ffffff;
        border-width: 2px;
        border-color: root.interactive ? Theme.accent : Theme.text3;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
    }

    property <bool> dragging: false;

    ta := TouchArea {
        enabled: root.interactive;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                fs.focus();
                root.dragging = true;
                root.set-from-pointer(ta.mouse-x);
            } else if (event.kind == PointerEventKind.move && root.dragging) {
                root.set-from-pointer(ta.mouse-x);
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (root.dragging) {
                    root.dragging = false;
                    root.released(root.value);
                }
            }
        }
    }

    fs := FocusScope {
        focus-on-click: false;
        enabled: root.interactive;
        focus-on-tab-navigation: !root.inert;
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.step-by(root.step);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.step-by(-root.step);
                return accept;
            }
            if (event.text == Key.Home) {
                root.changed(root.minimum);
                root.released(root.minimum);
                return accept;
            }
            if (event.text == Key.End) {
                root.changed(root.maximum);
                root.released(root.maximum);
                return accept;
            }
            return reject;
        }
    }

    if fs.has-focus && root.interactive : Rectangle {
        border-width: 1px;
        border-radius: 4px;
        border-color: Theme.accent;
    }

    // NOTE: never assign `root.value` here. The slider is usually driven by a
    // one-way binding (NumberSetting, preview scrubber); writing the property
    // would silently drop that binding after the first drag. Consumers of
    // `changed` write their own state back, which keeps the knob in sync.
    public function set-from-pointer(px: length) {
        if (root.maximum <= root.minimum) { return; }
        let f = Math.min(1.0, Math.max(0.0, px / Math.max(1px, root.width)));
        let raw = root.minimum + f * (root.maximum - root.minimum);
        let snapped = Math.round(raw / root.step) * root.step;
        root.changed(Math.min(root.maximum, Math.max(root.minimum, snapped)));
    }
}

// Slider paired with a direct numeric input.
component NumberSetting inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> description: "";
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in-out property <int> value: 0;
    callback describe(string);

    spacing: 12px;
    padding-top: 4px;
    padding-bottom: 4px;

    Rectangle {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        background: transparent;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: Theme.text2;
                font-size: 0.9375rem;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        ta := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.move && root.description != "") {
                    root.describe(root.description);
                }
            }
            clicked => {
                if (root.description != "") {
                    root.describe(root.description);
                }
            }
        }
    }

    SliderBar {
        width: 170px;
        y: (parent.height - self.height) / 2;
        minimum: root.minimum * 1.0;
        maximum: root.maximum * 1.0;
        step: root.step * 1.0;
        value: root.value * 1.0;
        changed(val) => {
            root.value = Math.round(val);
            root.describe(root.description);
        }
    }

    SpinBox {
        width: 96px;
        y: (parent.height - self.height) / 2;
        minimum: root.minimum;
        maximum: root.maximum;
        step-size: root.step;
        value <=> root.value;
        edited => { root.describe(root.description); }
    }
}

// Setting row: label on the left, control passed via @children on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> description: "";
    callback describe(string);

    spacing: 12px;
    padding-top: 4px;
    padding-bottom: 4px;

    Rectangle {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        background: transparent;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: Theme.text2;
                font-size: 0.9375rem;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        ta := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.move && root.description != "") {
                    root.describe(root.description);
                }
            }
            clicked => {
                if (root.description != "") {
                    root.describe(root.description);
                }
            }
        }
    }

    @children
}

// Custom checkbox so the control matches the theme (std-widgets draws a
// native blue square that ignores the accent color).
//
// The root is a plain Rectangle with a full-size TouchArea overlay: inside a
// HorizontalLayout a `TouchArea` child would be laid out as a *separate*
// column, so only the empty space to the right of the box used to be
// clickable. Here the box, the (optional) label and the hit area all share
// the same 34px square.
component CheckBox inherits Rectangle {
    in property <string> text: "";
    in-out property <bool> checked: false;
    in property <bool> interactive: true;
    callback toggled();

    horizontal-stretch: 0;
    min-width: 34px;
    height: 34px;
    background: transparent;

    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => {
        if (root.interactive) {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 8px;
        padding-right: 8px;

        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 5px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.border-strong;
            background: root.checked ? Theme.accent : Theme.input;
            opacity: root.interactive ? 1.0 : 0.62;

            if root.checked : Icon {
                source: Icons.check;
                icon-size: 12px;
                tint: Theme.on-accent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.text;
            color: root.interactive ? Theme.text2 : Theme.text3;
            font-size: 0.9375rem;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    ta := TouchArea {
        enabled: root.interactive;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// ----------------------------------------------------------------------------
// Application window
// ----------------------------------------------------------------------------
export component AppWindow inherits Window {
    title: window-title;
    icon: @image-url("../../../assets/timelapsemaker.png");
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 520px;
    // Borderless compositor fullscreen. F11 (or the header button) toggles it;
    // the Rust side deliberately does not persist this across launches.
    in-out property <bool> fullscreen-active: false;
    full-screen: root.fullscreen-active;
    background: @linear-gradient(160deg, #090d16 0%, #0b1220 55%, #0a1424 100%);
    default-font-size: font-size * 1px;
    forward-focus: app-keys;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Theme aliases keep the public Rust-facing API stable.
    in-out property <color> col-bg <=> Theme.bg;
    in-out property <color> col-card <=> Theme.card;
    in-out property <color> col-card-hover <=> Theme.card-hover;
    in-out property <color> col-border <=> Theme.border;
    in-out property <color> col-border-highlight <=> Theme.border-strong;
    in-out property <color> col-input <=> Theme.input;
    in-out property <color> col-text <=> Theme.text;
    in-out property <color> col-text2 <=> Theme.text2;
    in-out property <color> col-text3 <=> Theme.text3;
    in-out property <color> col-accent <=> Theme.accent;
    in-out property <color> col-hover <=> Theme.hover;
    in-out property <color> col-success <=> Theme.success;
    in-out property <color> col-warn <=> Theme.warn;
    in-out property <color> col-stage-blue <=> Theme.accent;

    // Localization strings
    in-out property <string> window-title: "TimelapseMaker";
    in-out property <string> app-version: "2.0.0";
    in-out property <string> str-settings: "Settings";
    in-out property <string> str-help: "Help";
    in-out property <string> str-about: "About TimelapseMaker";
