    in-out property <string> str-about-app-license: "Application code is MIT licensed.";
    in-out property <string> str-about-slint-license: "The interface is built with Slint and used under the Slint Royalty-free 2.0 license.";
    in-out property <string> str-about-third-party: "Third-party notices are included with every release.";
    in-out property <string> str-about-copyright: "Copyright © vamtic";
    in-out property <string> str-about-links: "slint.dev  ·  github.com/vamtic/makerr";
    in-out property <string> str-setup: "Setup";
    in-out property <string> str-setup-hint: "Complete the four steps, then create your timelapse.";
